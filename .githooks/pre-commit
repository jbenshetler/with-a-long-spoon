#!/bin/sh
# Pre-commit hook. Two independent, scoped checks — each runs only when files
# it cares about are staged, so unrelated commits aren't slowed.
#
# This hook is versioned but not auto-installed. Activate it on a fresh clone:
#     git config core.hooksPath .githooks
#
# 1. {{Chapter Title}} validation: when a meta/*.md file is staged, verify every
#    {{Title}} reference resolves to a real chapter (see CLAUDE.md).
# 1b. Volume-marker validation: when the chronology or meta-volumes.toml is
#    staged, verify the ◆ VOLUME markers agree with meta/meta-volumes.toml.
# 2. Chronology HTML regen: when a scene, the chronology doc, or a cold-read
#    review is staged, rebuild the local ignored chronology.html. The page
#    includes embedded cold reads under each chapter card, but remains a local
#    working artifact rather than staged/generated commit content. The per-scene
#    "updated" date is read from git history, so it lags the commit being made
#    by one — accepted by design; the local file is kept "current enough" by
#    regenerating on every scene change.

staged=$(git diff --cached --name-only --diff-filter=ACM)

# --- 1. title-reference validation (meta/*.md only) ------------------------
if printf '%s\n' "$staged" | grep -q '^meta/.*\.md$'; then
    if ! python3 tools/lint_titles.py --all; then
        echo "" >&2
        echo "pre-commit: a {{Title}} reference does not resolve to a chapter." >&2
        echo "Fix the title/alias or unbrace it, then re-commit." >&2
        echo "(To bypass in an emergency: git commit --no-verify)" >&2
        exit 1
    fi
fi

# --- 1b. volume markers vs meta-volumes.toml (chronology or volume data) ----
# build_epub.py and chronology_html.py read the chronology's ◆ VOLUME markers
# and section headings; everything else reads meta-volumes.toml. 74d58f4c
# (2026-10-12) deleted Volume One's marker and heading along with an adjacent
# entry, which emptied the Book 1 epub roster and the Book 1 progress row for a
# week while volume_scenes.py --check reported the mismatch to no one.
if printf '%s\n' "$staged" | grep -qE '^meta/(meta-plan-chronology\.md|meta-volumes\.toml)$'; then
    if ! python3 tools/volume_scenes.py --check; then
        echo "" >&2
        echo "pre-commit: the chronology's ◆ VOLUME markers disagree with meta/meta-volumes.toml." >&2
        echo "Restore or fix the marker/heading, then re-commit." >&2
        echo "(To bypass in an emergency: git commit --no-verify)" >&2
        exit 1
    fi
fi

# --- 1c. chronology weekdays vs the hidden calendar ------------------------
# tools/chapter_dates.py is the stable source for chapter-date calculation; a
# stated weekday that does not match its date on the 2026-27 calendar is a
# canon error, and so is a `days:` section anchor that a scene edit removed.
# Approximate/missing dates are listed but never block.
if printf '%s\n' "$staged" | grep -qE '^(meta/meta-plan-chronology\.md|scenes/.*\.md)$'; then
    if ! tools/chapter_dates.py --check >&2; then
        echo "" >&2
        echo "pre-commit: a chronology weekday does not match its date, or a days: anchor is gone (see above)." >&2
        echo "(To bypass in an emergency: git commit --no-verify)" >&2
        exit 1
    fi
fi

# --- 2. chronology HTML regen (scenes, chronology doc, or cold reads) --------
if printf '%s\n' "$staged" | grep -qE '^(scenes/.*\.md|meta/meta-plan-chronology\.md|reviews/cold-read/.*\.md)$'; then
    if ! tools/chronology_html.py; then
        echo "" >&2
        echo "pre-commit: chronology_html.py failed to regenerate the chronology HTML." >&2
        echo "Fix the generator (or the chronology doc), then re-commit." >&2
        echo "(To bypass in an emergency: git commit --no-verify)" >&2
        exit 1
    fi
fi

# --- 3. blurb/packet sync (jacket source or the reader packet) --------------
if printf '%s\n' "$staged" | grep -qE '^(meta/meta-blurb\.md|meta/meta-cover\.md|reviews/cold-read/volume-packets\.toml)$'; then
    if ! python3 tools/lint_blurb.py; then
        echo "" >&2
        echo "pre-commit: the jacket source changed but the reader packet is stale." >&2
        echo "Refresh reviews/cold-read/volume-packets.toml to match, then re-stamp:" >&2
        echo "    tools/lint_blurb.py --update" >&2
        echo "(To bypass in an emergency: git commit --no-verify)" >&2
        exit 1
    fi
fi

# --- 4. orphaned-reference warning (staged scenes) --------------------------
# When a revision cuts the text that INTRODUCED something, a later definite
# reference to it can survive and dangle — the reader meets "the closed
# camel-coat project" having never met the camel coat (the-pointing-game,
# ade99b4b). No reader-side instrument can catch this; the evidence is in the
# diff, which is exactly what a pre-commit hook is holding.
#
# WARNING ONLY, by author ruling (2026-09-19): it never blocks. The check
# over-flags by design and a surviving ordinary use is common, so the author
# judges. Note it inspects the LAST committed state of the staged files, so a
# dangle introduced by the commit in progress surfaces on the next one — it is
# a safety net for the class, not a gate on this diff.
#
# Run through the script's own shebang (`uv run --script`, Python >=3.11 pinned
# in its PEP 723 block) — NOT `python3 tools/…`, which would bypass uv and run
# the system interpreter. stderr stays silenced, so a missing uv would make the
# warning vanish without a trace; say so instead.
if printf '%s\n' "$staged" | grep -q '^scenes/.*\.md$'; then
    if command -v uv >/dev/null 2>&1; then
        tools/orphan_refs.py --staged 2>/dev/null || true
    else
        echo "pre-commit: orphan-refs check skipped — uv not installed" >&2
    fi
fi
